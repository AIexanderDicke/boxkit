# Copy this file to secrets.env (it is gitignored) and fill in your keys.
# secrets.env is loaded into the container env via docker compose env_file, AND
# is passed as a BuildKit build secret so the image can set up the
# password-protected `root-dev` sudoer. Because it is also used at build time it
# is REQUIRED: the image build fails without it (there is no NOPASSWD fallback).
# Note: the `dev` container user is NOT configured here; it defaults to "dev"
# (see entrypoint.sh / devcontainer.json remoteUser).

# Password for the `root-dev` privileged account. `dev` has no sudo, so this is
# how you escalate inside the container: `su - root-dev` and enter it. It is
# consumed at build time only; the plaintext is never written to the
# image (only its hash in /etc/shadow), and it is deliberately blanked out of the
# running container's environment (see docker-compose.yml). Keep it unquoted.
# After changing it, rebuild WITHOUT cache (BuildKit caches secrets).
ROOT_DEV_PASSWORD=

# Seeds OpenCode auth (written to ~/.local/share/opencode/auth.json in post-create.sh)
OPENCODE_API_KEY=

# Optional: picked up by Claude Code / Codex directly if you use them with env auth
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Git & GitHub --------------------------------------------------------------
# Identity written to ~/.gitconfig by post-create.sh (persists on the home volume).
GIT_USER_NAME=
GIT_USER_EMAIL=

# GitHub access: a PAT used by the gh CLI and as the git credential helper for
# github.com (see post-create.sh). Needs at least "repo" scope.
GH_TOKEN=
GITHUB_USER=
