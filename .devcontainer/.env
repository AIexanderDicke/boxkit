NODE_VERSION=22.23.2
PNPM_VERSION=12.4.2
PYTHON_VERSION=3.13.15
UV_VERSION=0.12.17
CODEX_VERSION=0.155.1
OPENCODE_VERSION=1.18.31
LAZYDOCKER_VERSION=0.25.2
REVDIFF_VERSION=1.13.0

# Host path of the Docker daemon socket forwarded into the container
# (Docker-outside-of-Docker, see docker-compose.yml). entrypoint.sh exposes it to
# `dev` via a root-owned socat proxy, so no privileged container is needed.
# Rootless Docker: /run/user/$(id -u)/docker.sock  (change 1000 to your UID)
# Rootful Docker:  /var/run/docker.sock
DOCKER_HOST_SOCKET=/var/run/docker.sock
